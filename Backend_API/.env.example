# Production environment variables for Rovistar
# Copy this file to .env and fill in real values before deploying.

# App
APP_NAME=Rovistar API
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database (PostgreSQL on Supabase/Neon/Render)
# Set ENVIRONMENT=production and use long random secrets before deployment.
ENVIRONMENT=development
MINISHOP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

DATABASE_URL=postgresql://user:password@host:5432/rokikadb

# CORS (frontend URLs that can call this API)
CORS_ORIGINS=https://www.rovistar.shop,https://rovistar.shop,https://admin.rovistar.shop,https://dashboard.rovistar.shop,https://reseller.rovistar.shop,https://telegram.rovistar.shop

# URLs
STORE_URL=https://www.rovistar.shop
API_URL=https://api.rovistar.shop

# Admin bootstrap
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=change-me-admin-password

# ABA Pay (leave empty until configured)
ABA_MERCHANT_ID=
ABA_ACCESS_TOKEN=
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Platform shop (collects plan payments)
PLATFORM_SHOP_USERNAME=demo

# Reseller / referral
REFERRAL_SECRET=change-me-to-a-random-string

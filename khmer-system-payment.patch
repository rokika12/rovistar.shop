diff --git a/Backend_API/services/khmer_system_service.py b/Backend_API/services/khmer_system_service.py
new file mode 100644
index 0000000..17efd92
--- /dev/null
+++ b/Backend_API/services/khmer_system_service.py
@@ -0,0 +1,159 @@
+"""KHMER SYSTEM payment gateway client.
+
+The provider requires a unique 10-character verify key and the authenticated
+customer's Telegram ID for every payment. Keys never leave the backend.
+"""
+import secrets
+import string
+
+import httpx
+
+
+BASE_URL = "https://pay.khmer-system.com"
+
+
+class PaymentNotConfigured(Exception):
+    """Raised when a shop has not saved its KHMER SYSTEM merchant key."""
+
+
+class PaymentGatewayUnavailable(Exception):
+    """Raised when KHMER SYSTEM cannot create a usable payment."""
+
+
+def _config(shop):
+    settings = shop.aba_dict()
+    return (settings.get("khmer_system_secret_key") or "").strip()
+
+
+def is_configured(shop) -> bool:
+    return bool(_config(shop))
+
+
+def generate_verify_key() -> str:
+    """Return the provider-required 10-character alphanumeric idempotency key."""
+    alphabet = string.ascii_letters + string.digits
+    return "".join(secrets.choice(alphabet) for _ in range(10))
+
+
+def _payment_identity(order):
+    customer = getattr(order, "customer", None)
+    telegram_id = getattr(customer, "telegram_id", None)
+    if not telegram_id:
+        raise PaymentNotConfigured(
+            "KHMER SYSTEM requires the customer to sign in with Telegram before payment."
+        )
+    return str(telegram_id)
+
+
+def _request(method: str, path: str, *, json=None, params=None) -> dict:
+    try:
+        with httpx.Client(timeout=httpx.Timeout(12.0, connect=4.0)) as client:
+            response = client.request(method, f"{BASE_URL}{path}", json=json, params=params)
+            response.raise_for_status()
+            payload = response.json()
+    except (httpx.HTTPError, ValueError) as exc:
+        raise PaymentGatewayUnavailable("KHMER SYSTEM is temporarily unavailable. Please try again.") from exc
+
+    if not isinstance(payload, dict) or not payload.get("success"):
+        message = payload.get("error") if isinstance(payload, dict) else "Invalid response from KHMER SYSTEM"
+        raise PaymentGatewayUnavailable(message or "KHMER SYSTEM could not create the payment.")
+    return payload
+
+
+def create_payment(order, shop) -> dict:
+    secret_key = _config(shop)
+    if not secret_key:
+        raise PaymentNotConfigured("KHMER SYSTEM secret key is not configured for this shop.")
+
+    telegram_user_id = _payment_identity(order)
+    verify_key = generate_verify_key()
+    payload = _request("POST", "/api/v1/payment/generate", json={
+        "secret_key": secret_key,
+        "amount": round(float(order.total or 0), 2),
+        "verify_key": verify_key,
+        "telegram_user_id": telegram_user_id,
+    })
+
+    transaction_id = str(payload.get("transaction_id") or "").strip()
+    qr_image_url = str(payload.get("qr_image_url") or "").strip()
+    if not transaction_id or not qr_image_url:
+        raise PaymentGatewayUnavailable("KHMER SYSTEM returned no transaction ID or QR image.")
+
+    return {
+        "transaction_id": transaction_id,
+        "amount": payload.get("amount", order.total),
+        "currency": payload.get("currency", order.currency),
+        "qr_code_url": qr_image_url,
+        "qr_content": payload.get("qr_string", ""),
+        "status": payload.get("status", "pending"),
+        "expired_at": payload.get("expired_at"),
+        "provider": "khmer_system",
+        "payment_detail": {
+            "provider": "khmer_system",
+            "verify_key": verify_key,
+            "telegram_user_id": telegram_user_id,
+            "qr_code_url": qr_image_url,
+            "amount": payload.get("amount", order.total),
+            "currency": payload.get("currency", order.currency),
+            "expired_at": payload.get("expired_at"),
+        },
+    }
+
+
+def existing_payment(order) -> dict | None:
+    """Reuse an unexpired provider payment when the storefront retries the QR."""
+    detail = order.payment_detail_dict()
+    if detail.get("provider") != "khmer_system" or not order.transaction_id or not detail.get("qr_code_url"):
+        return None
+    return {
+        "transaction_id": order.transaction_id,
+        "amount": detail.get("amount", order.total),
+        "currency": detail.get("currency", order.currency),
+        "qr_code_url": detail["qr_code_url"],
+        "status": "pending",
+        "expired_at": detail.get("expired_at"),
+        "provider": "khmer_system",
+    }
+
+
+def verify_payment(order, shop) -> dict:
+    secret_key = _config(shop)
+    if not secret_key:
+        return {"verified": False, "status": "not_configured", "error": "KHMER SYSTEM is not configured"}
+
+    detail = order.payment_detail_dict()
+    verify_key = str(detail.get("verify_key") or "").strip()
+    telegram_user_id = str(detail.get("telegram_user_id") or "").strip()
+    if not verify_key or not telegram_user_id:
+        return {"verified": False, "status": "error", "detail": "Payment reference is missing"}
+
+    payload = _request("GET", "/api/v1/payment/check", params={
+        "secret_key": secret_key,
+        "verify_key": verify_key,
+        "telegram_user_id": telegram_user_id,
+    })
+    status = str(payload.get("status") or "pending").lower()
+    return {
+        "verified": status == "completed",
+        "status": status,
+        "transaction_id": order.transaction_id,
+        "amount": payload.get("amount"),
+        "detail": payload,
+    }
+
+
+def confirm_payment(order, shop) -> None:
+    """Record the completed credit at the provider after local fulfillment starts."""
+    secret_key = _config(shop)
+    detail = order.payment_detail_dict()
+    if not secret_key or not detail.get("verify_key") or not detail.get("telegram_user_id"):
+        return
+    try:
+        _request("POST", "/api/v1/payment/confirm", json={
+            "secret_key": secret_key,
+            "verify_key": detail["verify_key"],
+            "telegram_user_id": detail["telegram_user_id"],
+        })
+    except PaymentGatewayUnavailable:
+        # Payment is already captured locally; later status checks can retry this audit call.
+        return

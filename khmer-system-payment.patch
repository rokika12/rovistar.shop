@@ -0,0 +1,60 @@
+"""Focused contract tests for the KHMER SYSTEM adapter."""
+import sys
+import unittest
+from types import SimpleNamespace
+
+sys.path.insert(0, ".")
+
+from services import khmer_system_service as service
+
+
+class KhmerSystemServiceTests(unittest.TestCase):
+    def setUp(self):
+        self.shop = SimpleNamespace(aba_dict=lambda: {"khmer_system_secret_key": "sk_live_test"})
+        self.order = SimpleNamespace(
+            total=5.50,
+            currency="USD",
+            transaction_id="TXN_1",
+            customer=SimpleNamespace(telegram_id=123456),
+            payment_detail_dict=lambda: {"verify_key": "Ab12Cd34Ef", "telegram_user_id": "123456"},
+        )
+
+    def test_create_payment_maps_provider_response(self):
+        original = service._request
+        captured = {}
+
+        def fake_request(method, path, **kwargs):
+            captured.update({"method": method, "path": path, **kwargs})
+            return {"success": True, "transaction_id": "TXN_1", "qr_image_url": "https://pay.example/qr", "status": "pending"}
+
+        service._request = fake_request
+        try:
+            result = service.create_payment(self.order, self.shop)
+        finally:
+            service._request = original
+
+        self.assertEqual(captured["method"], "POST")
+        self.assertEqual(captured["path"], "/api/v1/payment/generate")
+        self.assertEqual(captured["json"]["telegram_user_id"], "123456")
+        self.assertRegex(captured["json"]["verify_key"], r"^[A-Za-z0-9]{10}$")
+        self.assertEqual(result["provider"], "khmer_system")
+
+    def test_verify_completed_payment(self):
+        original = service._request
+        service._request = lambda *args, **kwargs: {"success": True, "status": "completed", "amount": 5.50}
+        try:
+            result = service.verify_payment(self.order, self.shop)
+        finally:
+            service._request = original
+
+        self.assertTrue(result["verified"])
+        self.assertEqual(result["status"], "completed")
+
+    def test_missing_telegram_identity_is_rejected(self):
+        self.order.customer.telegram_id = None
+        with self.assertRaises(service.PaymentNotConfigured):
+            service.create_payment(self.order, self.shop)
+
+
+if __name__ == "__main__":
+    unittest.main()

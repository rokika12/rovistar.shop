From: Cy <cy@users.noreply.github.com>
Date: Tue, 29 Sep 2026 10:45:43 +0000
Subject: [PATCH] Match service payment cards to wallet design

---
 Frontend_User/src/index.css              | 59 ++++++++++++++++++++++++
 Frontend_User/src/pages/ProductDetail.js | 38 ++++++++++-----
 2 files changed, 86 insertions(+), 11 deletions(-)

diff --git a/Frontend_User/src/index.css b/Frontend_User/src/index.css
index 5dfcc76..0cb847d 100644
--- a/Frontend_User/src/index.css
+++ b/Frontend_User/src/index.css
@@ -1614,6 +1614,65 @@ body {
   object-fit: contain;
   object-position: center;
 }
+
+/* Compact payment choices match the wallet-first checkout design. */
+.service-payment-picker {
+  max-width: 30.1rem;
+}
+.service-payment-card {
+  display: grid;
+  width: 100%;
+  min-height: 5.25rem;
+  grid-template-columns: 3.2rem minmax(0, 1fr) 1.6rem;
+  align-items: center;
+  gap: 0.95rem;
+  border: 2px solid #cbd7e6;
+  border-radius: 1rem;
+  background: #fff;
+  padding: 0.85rem 1rem;
+  color: #263249;
+  text-align: left;
+  transition: border-color 160ms ease, box-shadow 160ms ease;
+}
+.service-payment-card:hover { border-color: #8eb8fa; }
+.service-payment-card-selected {
+  border-color: #347cf5;
+  box-shadow: 0 4px 12px rgba(52, 124, 245, 0.2);
+}
+.service-payment-icon {
+  display: grid;
+  width: 3.2rem;
+  height: 3.2rem;
+  place-items: center;
+  overflow: hidden;
+  border-radius: 0.65rem;
+}
+.service-payment-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
+.service-payment-wallet-icon { background: #eaf2ff; padding: 0.65rem; }
+.service-payment-khqr-icon { background: #fff; }
+.service-payment-copy { min-width: 0; }
+.service-payment-copy strong,
+.service-payment-copy small { display: block; }
+.service-payment-copy strong { color: #263249; font-size: 1rem; font-weight: 800; line-height: 1.2; }
+.service-payment-copy small { margin-top: 0.28rem; color: #65758f; font-size: 0.81rem; font-weight: 700; line-height: 1.2; }
+.service-payment-radio {
+  width: 1.55rem;
+  height: 1.55rem;
+  border: 2px solid #cbd7e6;
+  border-radius: 50%;
+  background: #fff;
+}
+.service-payment-card-selected .service-payment-radio {
+  border: 7px solid #347cf5;
+}
+@media (max-width: 640px) {
+  .service-payment-picker { max-width: none; }
+  .service-payment-card { min-height: 5.15rem; grid-template-columns: 3.05rem minmax(0, 1fr) 1.45rem; gap: 0.8rem; padding: 0.75rem 0.9rem; }
+  .service-payment-icon { width: 3.05rem; height: 3.05rem; }
+  .service-payment-copy strong { font-size: 0.94rem; }
+  .service-payment-copy small { font-size: 0.75rem; }
+  .service-payment-radio { width: 1.45rem; height: 1.45rem; }
+}
 .checkout-payment-marks {
   overflow: visible;
   gap: 0.45rem;
